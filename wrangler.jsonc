// Cloudflare Worker for www.carsandcoffee.uk
// - src/worker.js builds the homepage from the Cars and Coffee database (edited in admin.carsandcoffee.uk), cached 60s,
//   and redirects carsandcoffee.uk -> www.carsandcoffee.uk (301). Everything else in ./public is served as-is.
// - Both hostnames are attached as Custom Domains on deploy (the zone is in this Cloudflare account).
{
  "name": "carsandcoffee",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.carsandcoffee.uk", "custom_domain": true },
    { "pattern": "carsandcoffee.uk", "custom_domain": true }
  ],
  "workers_dev": true,
  // Workers AI: powers "Ask Cars and Coffee" (header search and the help chat). See src/assist.js.
  "ai": { "binding": "AI" },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }]
}
