// Cloudflare Worker for www.carsandcoffee.uk
// - Static site: everything in ./public is served as-is (no build step).
// - src/worker.js redirects carsandcoffee.uk -> www.carsandcoffee.uk (301).
// - Both hostnames are attached as Custom Domains on deploy (the zone is in this Cloudflare account).
{
  "name": "carsandcoffee",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.carsandcoffee.uk", "custom_domain": true },
    { "pattern": "carsandcoffee.uk", "custom_domain": true }
  ],
  "workers_dev": true
}
