// Cloudflare Worker for the members' club: https://club.carsandcoffee.uk
// Static single-page app in ./public (no build step). Talks to the
// "Cars and Coffee Community" Supabase project from the browser.
{
  "name": "carsandcoffee-club",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "club.carsandcoffee.uk", "custom_domain": true }
  ],
  "workers_dev": true
}
